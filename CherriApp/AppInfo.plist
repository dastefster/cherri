<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.dastefster.CherriApp</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>cherrishortcuts</string>
			</array>
		</dict>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Cherri Shortcuts connects to Cherri Helper on your Mac, and only if you choose to sign on your Mac in Settings.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_cherri-signer._tcp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Cherri Shortcuts uses the camera only to scan the pairing QR code that Cherri Helper shows on your Mac.</string>
</dict>
</plist>
