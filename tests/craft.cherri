// compile-only: these Craft actions act on a real Craft account, so there is nothing to assert on.
@runActions = "no"

// Reference values come from device exports of every action below. Pickers that need Craft content are left blank.
if @runActions == "yes" {
    const doc = craftCreateDocument("Title", "Content")
    craftCreateDocument(nil, "Content only")
    craftCreateDocument("Title only")
    craftCreateDocument()

    craftFindPage("Title")
    craftFindPage()

    // The count is stored as text.
    craftGetBlocks(1)
    craftGetBlocks()

    craftAddToDocument(doc)
    craftAddSubpageToDocument()
    craftDeleteDocument()
    craftMoveDocument()
    craftRenameDocument()
    craftOpenDocument()
    craftOpenDailyNote()

    craftCreateFolder("Name")
    craftCreateFolder()
    craftRenameFolder("New name")
    craftDeleteFolder()
    craftMoveFolder()
    craftOpenFolder()
    craftOpenAndSearch()
    craftOpenQuickEntry()
    craftOpenTag()
    craftCreateReminder("Reminder")
    craftCreateTask("Title", "Content")
    craftCreateTask("Title only")
    craftSetTaskStatus()
}


// Siri-style Craft notes, reminders and search
craftAppendTextToNote("appended text")
craftCreateNote("Test note", "Note body")
const craftReminder = craftCreateReminderInList("Test reminder")
craftDeleteReminders(craftReminder)
const craftNotes = craftFindNote()
craftOpenNote(craftNotes)
craftOpenReminder(craftReminder)
craftSearchDocuments("meeting")
craftUpdateNote()
craftUpdateReminder("updated note")
craftOpenTasksList()

show("✅ All tests passed")
