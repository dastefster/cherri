// compile-only: stdfunc functions, interactive at runtime

#include 'stdfunc'

const returnStr = "Hello, World"

const jsResult = runJS("document.body.append(document.createTextNode('{returnStr}'));")
if jsResult.text != returnStr {
    mustOutput("❌ FAIL: JS returned unexpected value", "❌ FAIL: JS returned unexpected value")
}

@items = []
repeat i for 6 {
    @items += makeVCard("Title", "Subtitle")
}

@choice = chooseFromVCard(@items, "Prompt")
show("{@choice}")

// search: an array literal passed for the result types
const spotlight = search("Cherri", 3, ["Notes", "Reminders"])
show("{spotlight}")
