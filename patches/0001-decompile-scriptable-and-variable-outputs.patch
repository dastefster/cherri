+func selectAction(call action) {
+	setCurrentAction(call.ident, actions[call.ident])
+	if call.ident == "rawAction" && len(call.args) > 0 {
+		currentAction.definition.overrideIdentifier = getArgValue(call.args[0]).(string)
+	}
